# Bu dosya sadece örnektir; gerçek secret içermez.
# Local development için: `cp .env.example .env` yapıp kendi değerlerinle doldur.
# Production .env dosyası GitHub'a gönderilmez; VPS üzerinde ayrıca ve
# manuel olarak yönetilir.

NODE_ENV=development
PORT=4100

# Local: VPS'teki postgres container'ına SSH tunnel ile bağlan (bkz. README).
# Production: VPS'teki "postgres" container'ına Docker network üzerinden
# bağlanılır (container portu 5432, host portu değil):
#   postgresql://greenpi_user:PRODUCTION_PASSWORD@postgres:5432/greenpi_db?schema=public
DATABASE_URL=postgresql://greenpi_user:CHANGE_ME@localhost:15432/greenpi_db?schema=public

JWT_SECRET=change-me

ADMIN_PASSWORD_HASH=

# Birden fazla origin izin vermek için virgülle ayır
CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
